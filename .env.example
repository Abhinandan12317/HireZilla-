# ==============================================================================
# HireZilla Environment Configuration
# Supports unified local dev (port 3000) AND decoupled AWS frontend/backend parts.
# ==============================================================================

# --- AI & Auth ---
# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for ID token verification.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# --- Ports & Decoupled AWS URLs ---
# BACKEND_PORT: Port used by standalone /backend server (default 4000; root unified server uses 3000)
BACKEND_PORT="4000"

# FRONTEND_URL / APP_URL: Public origin of the deployed frontend (used for CORS & interview links)
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# CORS_ORIGIN: Comma-separated allowed frontend origins for cross-origin AWS API requests
# Example: "https://app.hirezilla.io,https://www.hirezilla.io"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# VITE_API_BASE_URL: Set in frontend build when frontend calls backend directly on a separate domain
# Leave empty when frontend and backend share an origin or use frontend/server.ts proxy (BACKEND_URL).
VITE_API_BASE_URL=""

# BACKEND_URL: Optional internal ALB/App Runner backend URL for frontend/server.ts /api reverse proxy
BACKEND_URL="http://localhost:4000"

# --- Database (MongoDB) ---
# When omitted in local/test mode, HireZilla uses a local disk-backed Mongo-compatible store.
MONGODB_URI=""
MONGODB_DB_NAME="hirezilla"

# --- Security & Cross-Origin Cookies ---
# SESSION_SECRET: Server-side HMAC secret for session cookies & Bearer tokens.
SESSION_SECRET=""

# SIGNED_URL_SECRET: Secret for short-lived private resume download URLs.
SIGNED_URL_SECRET=""

# Cross-origin cookie tuning (use "none" + "true" if frontend & backend are on different HTTPS domains)
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# ADMIN_BOOTSTRAP_EMAILS: Comma-separated trusted emails provisioned as admin on sign-in.
ADMIN_BOOTSTRAP_EMAILS=""

# --- Resume Processing Limits ---
RESUME_MAX_SIZE_MB="5"
RESUME_MAX_PAGES="10"
OCR_ENABLED="false"
