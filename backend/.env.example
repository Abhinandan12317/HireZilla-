# Standalone Backend Service Environment (AWS ECS / App Runner / EC2)
PORT=4000
NODE_ENV=production

# Public URL of the separately deployed HireZilla frontend (used in CORS & interview links)
FRONTEND_URL="https://app.hirezilla.example.com"
CORS_ORIGIN="https://app.hirezilla.example.com"

# Cross-origin cookie settings when frontend and backend are on different domains in AWS
COOKIE_SAME_SITE="none"
COOKIE_SECURE="true"
# COOKIE_DOMAIN=".hirezilla.example.com"

# Database (MongoDB Atlas / Amazon DocumentDB)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/hirezilla"
MONGODB_DB_NAME="hirezilla"

# Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
SIGNED_URL_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=""
ADMIN_BOOTSTRAP_EMAILS="admin@hirezilla.local"
